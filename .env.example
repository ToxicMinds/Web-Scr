# -----------------------------------------------------------------------------
# Example environment file. Copy to `.env` and fill in real values.
# NEVER commit a real `.env`. In CI these are provided via GitHub Secrets.
# -----------------------------------------------------------------------------

# --- Supabase (Postgres source of truth) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Target optimization defaults ---
OPTIMIZER_DESTINATION_COUNTRY=SK           # ISO-3166 alpha-2 (Slovakia)
OPTIMIZER_BASE_CURRENCY=EUR

# --- Scraping ---
# Path where Playwright stores browsers. Leave as "default" to use its default.
PLAYWRIGHT_BROWSERS_PATH=default
SCRAPER_USER_AGENT=supplement-optimizer/0.1 (+https://github.com/ToxicMinds/Web-Scr)
SCRAPER_REQUEST_TIMEOUT_SECONDS=30
SCRAPER_MAX_CONCURRENCY=4

# --- Notifications ---
# Slack/Teams/Discord-compatible incoming webhook used by CI for run summaries.
NOTIFICATION_WEBHOOK=

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
